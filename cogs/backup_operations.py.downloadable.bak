class BackupOperations(commands.Cog):
    def __init__(self, bot):
        self.bot = bot
        self.db_path = "db/backup.sqlite"
        self.api_url = "https://wosland.com/apidc/backup_api/backup_api.php"
        self.api_key = "serioyun_backup_api_key_2024"
        self.log_path = "log/backuplog.txt"
        os.makedirs("log", exist_ok=True)
        self.setup_database()
        self.automatic_backup_loop.start()

    def setup_database(self):
        os.makedirs("db", exist_ok=True)
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS backup_passwords (
                discord_id TEXT PRIMARY KEY,
                backup_password TEXT NOT NULL,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        ''')
        
        conn.commit()
        conn.close()

    def cog_unload(self):
        self.automatic_backup_loop.cancel()

    @tasks.loop(hours=3)
    async def automatic_backup_loop(self):
        pass

    @automatic_backup_loop.before_loop
    async def before_automatic_backup(self):
        await self.bot.wait_until_ready()

    async def show_backup_menu(self, interaction: discord.Interaction):
        if not check_permission(interaction.user.id, interaction.guild_id, "admin"):
            await interaction.response.send_message("❌ You don't have permission to use backup operations.", ephemeral=True)
            return

        embed = discord.Embed(
            title="💾 Backup System",
            description=(
                "Backup system is loaded.\n\n"
                "**Available Operations**\n"
                "━━━━━━━━━━━━━━━━━━━━━━\n"
                "🏠 **Main Menu**\n"
                "└ Return to settings\n"
                "━━━━━━━━━━━━━━━━━━━━━━"
            ),
            color=discord.Color.blue()
        )
        view = BackupMenuView(self)
        await interaction.response.edit_message(embed=embed, view=view)



async def get_available_alliances(user_id: int, guild_id: int):
    if guild_id is None:
        return []

    if not check_permission(user_id, guild_id, "mod"):
        return []

    is_admin = check_permission(user_id, guild_id, "admin")
    is_owner = (user_id == 1237812594140512347)

    with sqlite3.connect("db/alliance.sqlite") as adb:
        acursor = adb.cursor()

        if is_owner or not is_admin:
            acursor.execute("""
                SELECT alliance_id, name
                FROM alliance_list
                WHERE discord_server_id = ?
                ORDER BY name
            """, (guild_id,))
            alliances = acursor.fetchall()
        else:
            with sqlite3.connect("db/settings.sqlite") as sdb:
                scursor = sdb.cursor()
                scursor.execute("""
                    SELECT alliance_id
                    FROM admin_alliances
                    WHERE guild_id = ? AND user_id = ?
                """, (guild_id, user_id))
                assigned = [r[0] for r in scursor.fetchall()]

            if not assigned:
                acursor.execute("""
                    SELECT alliance_id, name
                    FROM alliance_list
                    WHERE discord_server_id = ?
                    ORDER BY name
                """, (guild_id,))
                alliances = acursor.fetchall()
            else:
                placeholders = ",".join("?" * len(assigned))
                acursor.execute(f"""
                    SELECT alliance_id, name
                    FROM alliance_list
                    WHERE discord_server_id = ? AND alliance_id IN ({placeholders})
                    ORDER BY name
                """, [guild_id] + assigned)
                alliances = acursor.fetchall()

    results = []
    with sqlite3.connect("db/users.sqlite") as udb:
        ucursor = udb.cursor()
        for alliance_id, name in alliances:
            ucursor.execute("SELECT COUNT(*) FROM users WHERE alliance = ?", (alliance_id,))
            member_count = ucursor.fetchone()[0]
            results.append((alliance_id, name, member_count))

    return results


class AllianceSelect(discord.ui.Select):
    def __init__(self, alliances):
        self.alliance_map = {str(alliance_id): name for alliance_id, name, _ in alliances}
        options = [
            discord.SelectOption(
                label=name[:100],
                value=str(alliance_id),
                description=f"{member_count} members"
            )
            for alliance_id, name, member_count in alliances[:25]
        ]
        super().__init__(
            placeholder="Choose an alliance to export...",
            min_values=1,
            max_values=1,
            options=options
        )

    async def callback(self, interaction: discord.Interaction):
        selected_id = self.values[0]
        selected_label = self.alliance_map.get(selected_id, selected_id)
        await interaction.response.send_message(
            f"✅ Selected alliance: **{selected_label}**\nAlliance ID: `{selected_id}`\nBackup export wiring comes next.",
            ephemeral=True
        )


class ExportAllianceBackupView(discord.ui.View):
    def __init__(self, alliances):
        super().__init__(timeout=180)
        self.add_item(AllianceSelect(alliances))


class BackupMenuView(discord.ui.View):
    def __init__(self, cog):
        super().__init__(timeout=300)
        self.cog = cog

    @discord.ui.button(label="Export Alliance Backup", emoji="📤", style=discord.ButtonStyle.primary, row=0)
    async def export_backup_button(self, interaction: discord.Interaction, button: discord.ui.Button):
        alliances = await get_available_alliances(interaction.user.id, interaction.guild_id)
        if not alliances:
            await interaction.response.send_message(
                "❌ No alliances available for export.",
                ephemeral=True
            )
            return

        embed = discord.Embed(
            title="📤 Export Alliance Backup",
            description="Choose which alliance you want to export.",
            color=discord.Color.green()
        )
        await interaction.response.send_message(
            embed=embed,
            view=ExportAllianceBackupView(alliances),
            ephemeral=True
        )

    @discord.ui.button(label="Main Menu", emoji="🏠", style=discord.ButtonStyle.secondary, row=1)
    async def main_menu_button(self, interaction: discord.Interaction, button: discord.ui.Button):
        alliance_cog = self.cog.bot.get_cog("Alliance")
        if alliance_cog:
            await alliance_cog.show_main_menu(interaction)
        else:
            await interaction.response.send_message("❌ Settings menu not found.", ephemeral=True)

async def setup(bot):
    await bot.add_cog(BackupOperations(bot))
